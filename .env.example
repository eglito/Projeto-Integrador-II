# Copie para .env e troque os valores. O .env nunca vai para o repositório.

# Django
# Gere uma chave com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco. As três primeiras também criam o banco na primeira subida do container.
POSTGRES_DB=calistenia
POSTGRES_USER=calistenia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
