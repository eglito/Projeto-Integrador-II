# Modelo do .env de PRODUÇÃO, para a VM. Copie para .env e troque os valores.
# O .env nunca vai para o repositório. Na VM: chmod 600 .env
# (O .env.example é o do desenvolvimento.)

# Endereço público, sem "https://". O Caddy emite o certificado para ele; o DNS
# (registro A) já precisa apontar para o IP da VM antes de subir.
SITE_ADDRESS=mapa.example.com

# Django
# Gere uma chave com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=False
# O mesmo domínio de SITE_ADDRESS.
DJANGO_ALLOWED_HOSTS=mapa.example.com
# Liga o cabeçalho do proxy, cookies Secure, redirecionamento para HTTPS e HSTS
# (config/settings.py). Sem ele, o login atrás do Caddy falha com 403.
DJANGO_HTTPS=True
# Tempo do HSTS. Comece com 1 hora; depois de confirmar que tudo funciona, 31536000 (1 ano).
DJANGO_HSTS_SEGUNDOS=3600

# Banco. As três primeiras também criam o banco na primeira subida do container.
POSTGRES_DB=calistenia
POSTGRES_USER=calistenia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
